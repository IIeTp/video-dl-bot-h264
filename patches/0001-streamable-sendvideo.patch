+// parseResolution splits a yt-dlp resolution string like "1920x1080" into width and height.
+func parseResolution(s string) (width, height int) {
+	parts := strings.SplitN(strings.TrimSpace(s), "x", 2)
+	if len(parts) != 2 {
+		return 0, 0
+	}
+
+	width, _ = strconv.Atoi(strings.TrimSpace(parts[0]))
+	height, _ = strconv.Atoi(strings.TrimSpace(parts[1]))
+
+	return width, height
+}
